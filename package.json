{
  "name": "quicksave-backend",
  "version": "1.0.0",
  "description": "QuickSave backend — extracts video/audio download links from YouTube, TikTok, Facebook, and Instagram using yt-dlp, with Playwright for keyword search where yt-dlp can't search directly.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "postinstall": "npx playwright install --with-deps chromium"
  },
  "dependencies": {
    "express": "^4.19.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "dotenv": "^16.4.5",
    "winston": "^3.14.2",
    "zod": "^3.23.8",
    "express-rate-limit": "^7.4.0",
    "playwright": "^1.47.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
