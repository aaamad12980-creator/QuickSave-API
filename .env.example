# App
NODE_ENV=production
APP_NAME=QuickSave
PORT=5000
API_PREFIX=/api/v1

# Logging
LOG_LEVEL=info
LOG_DIR=logs

# CORS — set this to your actual Lovable site URL in production
# e.g. CORS_ORIGIN=https://quick7save.lovable.app
CORS_ORIGIN=*

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Storage (currently unused for downloads — everything streams as direct URLs)
TEMP_DIR=temp
DOWNLOADS_DIR=downloads

JSON_BODY_LIMIT=1mb

# yt-dlp
# Leave as "yt-dlp" if it's installed globally and available in PATH
YTDLP_PATH=yt-dlp
YTDLP_TIMEOUT_MS=30000
# Optional — only needed if you later want to support Instagram/Facebook
# links that require a logged-in session (private/restricted content)
YTDLP_COOKIES_FILE=

# Playwright (used for TikTok keyword search)
PLAYWRIGHT_TIMEOUT_MS=25000
PLAYWRIGHT_HEADLESS=true
